{
  "name": "omnishield-x-web",
  "version": "5.1.0",
  "private": true,
  "description": "OmniShield X v5.1 — World Monitor v2, country dashboards, source-backed intelligence and local-first DNS security.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "verify": "node scripts/verify.mjs",
    "ci": "npm run world:providers && npm run lint && npm test && npm run verify",
    "serve": "python3 -m http.server 8080 --bind 0.0.0.0",
    "build:extension": "node scripts/build-extension.mjs",
    "lint": "node scripts/lint.mjs",
    "stage": "node scripts/stage-site.mjs",
    "world:providers": "node scripts/sync-world-providers.mjs --check",
    "probe:world": "node scripts/probe-world.mjs",
    "test:browser": "node tests/browser/world-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "playwright": "^1.65.0"
  }
}
