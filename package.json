{
  "name": "omnishield-x-web",
  "version": "5.0.1",
  "private": true,
  "description": "OmniShield X \u2014 AETHER AI Evolution: DNS security, ad/tracker filtering, privacy and autonomous defense. Static, local-first web platform.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "verify": "node scripts/verify.mjs",
    "ci": "npm run lint && npm test && npm run verify",
    "serve": "python3 -m http.server 8080 --bind 0.0.0.0",
    "build:extension": "node scripts/build-extension.mjs",
    "lint": "node scripts/lint.mjs",
    "stage": "node scripts/stage-site.mjs",
    "freellmapi:setup": "node scripts/freellmapi-setup.mjs",
    "freellmapi:list": "npx freellmapi list",
    "freellmapi:doctor": "node -e \"import('./security/llm-advisor.js').then(m=>m.checkGateway(process.env.FREELLMAPI_URL, process.env.FREELLMAPI_API_KEY).then(r=>{console.log(JSON.stringify(r,null,2));process.exit(r.ok?0:1)}))\"",
    "skills:sync": "npx skills experimental_sync -y",
    "skills:list": "npx skills list"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "jsdom": "^30.1.3",
    "freellmapi": "^0.8.2"
  }
}
