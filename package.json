{
  "name": "omnishield-x-web",
  "version": "5.0.1",
  "private": true,
  "description": "OmniShield X — AETHER AI Evolution: DNS security, ad/tracker filtering, privacy and autonomous defense. Static, local-first web platform.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "verify": "node scripts/verify.mjs",
    "ci": "npm run verify && npm test",
    "serve": "python3 -m http.server 8080 --bind 0.0.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
