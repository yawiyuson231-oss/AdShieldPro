{
  "name": "adshield-pro",
  "version": "5.0.1",
  "private": true,
  "description": "AdShield Pro (OmniShield X) \u2014 Android DNS filtering client, Chrome ad-blocking extension, and a cross-platform battery monitor (Windows, macOS, Linux, iOS core).",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "build:extension": "node scripts/build-extension.mjs",
    "check:extension": "node scripts/build-extension.mjs --check",
    "battery": "node desktop/src/main.js",
    "battery:once": "node desktop/src/main.js --once",
    "battery:serve": "node desktop/src/main.js --serve 7317",
    "test:ios": "cd ios && swift test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-3.0-or-later"
}
