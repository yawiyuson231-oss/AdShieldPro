# Local Android and Gradle state
.gradle/
.kotlin/
.idea/
**/build/
local.properties
signing.properties

# TDLib native libraries are fetched + checksum-verified by :app:fetchTdlibNative,
# never committed (see tdlib/native-checksums.sha256).
app/src/main/jniLibs/

# Release and debug packages stay out of source control
*.apk
*.aab

# Signing material and local secrets
*.jks
*.keystore
*.pem
*.p12
.env
.env.*
!*.env.example

# Node dependencies and logs
node_modules/
npm-debug.log*

package-lock.json
.DS_Store
*.log
.cache/
coverage/

# Locally assembled deploy tree (scripts/stage-site.mjs)
_site/

# CI log mirrors are force-added by the workflow only for failed runs
.ci/
.ci-mirror/

# Python bytecode from repo tooling
__pycache__/
tools/__pycache__/
