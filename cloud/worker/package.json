{
  "name": "adshield-cloud-worker",
  "version": "1.0.0",
  "private": true,
  "description": "AdShield Pro / CyberShield AI cloud storage backend on Cloudflare Workers + R2 + D1 (free tier only)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply adshield_cloud --local",
    "migrate:remote": "wrangler d1 migrations apply adshield_cloud --remote",
    "test": "node test/run-tests.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.6.2",
    "wrangler": "^3.78.12"
  }
}
