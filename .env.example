# AdShieldPro — optional FreeLLMAPI gateway config (never commit real keys)
# Copy to .env and fill in your unified key from http://localhost:3001 → Keys
FREELLMAPI_URL=http://localhost:3001
FREELLMAPI_URL_V1=http://localhost:3001/v1
FREELLMAPI_API_KEY=freellmapi-...
# Dashboard session token (from browser localStorage `freellmapi_dashboard_token`) — needed for `npx freellmapi keys *`
# FREELLMAPI_DASHBOARD_TOKEN=...

# FreeLLMAPI server env (if you run the gateway from source or Docker)
# ENCRYPTION_KEY= # 64 hex chars — generated via `openssl rand -hex 32` or `node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'`
# PORT=3001
